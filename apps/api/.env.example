# PostgreSQL connection (ACID transactions required for financial data).
# Locally, DATABASE_URL and DIRECT_URL are the same. On Supabase, DATABASE_URL
# is the pooled connection (port 6543, add "?pgbouncer=true") and DIRECT_URL
# is the direct connection (port 5432) — see prisma/schema.prisma.
DATABASE_URL="postgresql://pinus:pinus_dev_password@localhost:5432/pinus_dev?schema=public"
DIRECT_URL="postgresql://pinus:pinus_dev_password@localhost:5432/pinus_dev?schema=public"

# Redis (BullMQ job queues for import/calculation background processing)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# File storage (local disk in dev; swap for S3/Supabase Storage in prod)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# Seed admin user (created by prisma/seed.ts if no users exist)
SEED_ADMIN_EMAIL="admin@rsudlembang.go.id"
SEED_ADMIN_PASSWORD="ChangeMe123!"
